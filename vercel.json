{
  "version": 2,
  "builds": [
    { "src": "app.py", "use": "@vercel/python" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(css|js)/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "dest": "/static/$1/$2" },
    { "src": "/static/(.*)", "headers": { "cache-control": "public, max-age=86400, stale-while-revalidate=604800" }, "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "/app.py" }
  ]
}
